# Copy to .env and fill in the real password.
# Characters like @ : / # must be URL-encoded (%40 %3A %2F %23).
MONGODB_URI=mongodb+srv://oprakss_db_user:<db_password>@cluster0.txdowwg.mongodb.net/fitkidrox?retryWrites=true&w=majority

# Port the API listens on.
PORT=4000

# Admin panel login credentials (used at /admin on the frontend).
ADMIN_EMAIL=admin@fitkidrox.in
ADMIN_PASSWORD=change-me-password

# Razorpay Standard Checkout. Use test-mode keys while developing.
# KEY_SECRET must stay server-side only — never put it in the root .env.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx

# Single source of truth for the entry fee, in paise (₹1,250 = 125000).
ENTRY_FEE_PAISE=125000

# Number of trusted proxies in front of the app (Render's edge = 1).
# Only raise this if you add another proxy (e.g. a CDN): leaving it at 1 when
# two proxies exist lets clients forge X-Forwarded-For and bypass rate limits.
# TRUST_PROXY_HOPS=1
